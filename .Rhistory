library(ARDL)
library(urca)
library(tseries)
bulan <- 1:36
harga_emas <- c(
550,452,555,557,560,563,565,568,570,573,575,578,
580,583,585,588,540,593,595,598,600,603,605,608,
610,613,615,668,620,623,625,628,630,633,635,638
)
inflasi <- c(
3.2,3.1,3.0,3.4,3.5,3.6,3.4,3.3,3.5,3.6,4.2,3.8,
2.6,3.5,3.7,4.1,3.1,4.0,3.8,3.7,3.9,3.2,4.1,4.2,
4.0,3.9,4.1,4.0,4.3,3.1,3.9,4.3,4.3,4.4,3.1,4.6
)
data <- data.frame(bulan, harga_emas, inflasi)
dataku <- data
wb <- openxlsx::createWorkbook()
hs1 <- openxlsx::createStyle(fgFill = "#DCE6F1", halign = "CENTER", textDecoration = "italic",
border = "Bottom")
hs2 <- openxlsx::createStyle(fontColour = "#ffffff", fgFill = "#4F80BD",
halign = "center", valign = "center", textDecoration = "bold",
border = "TopBottomLeftRight")
openxlsx::addWorksheet(wb, "Data", gridLines = TRUE)
openxlsx::writeDataTable(wb, "Data", dataku, rowNames = FALSE, startRow = 2, startCol = 2, tableStyle = "TableStyleMedium21")
openxlsx::openXL(wb)
uji_stasioner <- urca::ur.df(harga_emas)
summary(uji_stasioner)
dharga_emas <- diff(harga_emas)
uji_stasioner <- urca::ur.df(dharga_emas)
summary(uji_stasioner)
uji_stasioner <- urca::ur.df(inflasi)
summary(uji_stasioner)
dinflasi <- diff(inflasi)
uji_stasioner <- urca::ur.df(dinflasi)
summary(uji_stasioner)
library(ARDL)
lag_optimal <- auto_ardl(
harga_emas ~ inflasi,
data = data,
max_order = c(3, 3),  # lag maksimum (Y, X1, X2)
selection = "AIC"
)
lag_optimal$best_order
lag_optimal$top_orders
