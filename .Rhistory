inflasi <- (data[,"inflasi"])
hargaemas <- (data[,"harga_emas"])
coint_model <- lm(hargaemas ~ inflasi)
#summary(coint_model)
residual <- residuals(coint_model)
delta_inflasi <- diff(data[,"inflasi"])
delta_hargaemas <- diff(data[,"harga_emas"])
ECT <- residual[-c(  length(residual)  )]
ecm_model <- lm(delta_hargaemas ~ delta_inflasi + ECT, data = NULL)
summary(ecm_model)
